# Genera una clave propia; no uses este texto como clave.
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos para EC2 y phpMyAdmin.
DB_ENGINE=mysql
DB_NAME=newmix
DB_USER=newmix_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Para pruebas locales sin MySQL: DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
# True solamente si el sitio ya tiene HTTPS.
COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
# True sólo detrás de NGINX que sobrescriba X-Forwarded-Proto y Gunicorn privado.
TRUST_PROXY_HEADERS=False
